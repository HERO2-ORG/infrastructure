{
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Error and exception monitoring across backend and Flutter app",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (errorType, env) (count_over_time({env=~\"$env\"} | json level, errorType | level = \"error\" | errorType != \"\" [$__auto]))",
          "legendFormat": "{{errorType}} ({{env}})",
          "refId": "A"
        }
      ],
      "title": "Error rate by type",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Count" },
            "properties": [
              { "id": "custom.width", "value": 100 },
              { "id": "custom.align", "value": "right" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "errorType" },
            "properties": [
              { "id": "custom.width", "value": 320 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "source" },
            "properties": [
              { "id": "custom.width", "value": 100 }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 14, "x": 0, "y": 8 },
      "id": 2,
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Count" }]
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (errorType, source, env) (count_over_time({env=~\"$env\"} | json level, errorType, source | level = \"error\" | errorType != \"\" [$__range]))",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Error groups",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": { "mode": "columns", "valueLabel": "Count" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "Value": "Count" }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [{ "id": "displayName", "value": "Total errors" }]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [{ "id": "displayName", "value": "Flutter errors" }]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "C" },
            "properties": [{ "id": "displayName", "value": "Backend errors" }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 8 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({env=~\"$env\"} | json level | level = \"error\" [$__range]))",
          "instant": true,
          "legendFormat": "Total errors",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({env=~\"$env\", source=\"flutter\"} | json level | level = \"error\" [$__range]))",
          "instant": true,
          "legendFormat": "Flutter errors",
          "refId": "B"
        },
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({env=~\"$env\", source!=\"flutter\"} | json level | level = \"error\" [$__range]))",
          "instant": true,
          "legendFormat": "Backend errors",
          "refId": "C"
        }
      ],
      "title": "Error totals",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 18 },
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{env=~\"$env\"} | json level, errorType, source, message, stackTrace, analyticsId, sessionId, appVersion, deviceModel, osVersion | level = \"error\" | errorType =~ \"$errorType\"",
          "refId": "A"
        }
      ],
      "title": "Raw error logs — drill-down (filter by errorType variable above)",
      "type": "logs"
    }
  ],
  "schemaVersion": 39,
  "tags": ["errors", "loki"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "staging|production", "value": "staging|production" },
        "hide": 0,
        "includeAll": false,
        "label": "Environment",
        "multi": false,
        "name": "env",
        "options": [
          { "selected": true, "text": "staging|production", "value": "staging|production" },
          { "selected": false, "text": "staging", "value": "staging" },
          { "selected": false, "text": "production", "value": "production" }
        ],
        "query": "staging|production,staging,production",
        "type": "custom"
      },
      {
        "current": { "selected": false, "text": ".*", "value": ".*" },
        "hide": 0,
        "label": "Error type (regex)",
        "name": "errorType",
        "options": [],
        "query": ".*",
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m"],
    "time_options": ["1h", "6h", "24h", "7d", "30d"]
  },
  "timezone": "browser",
  "title": "Error Monitoring",
  "uid": "error-monitoring",
  "version": 1
}
