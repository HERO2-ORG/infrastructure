apiVersion: 1

providers:
  - name: hero2-default
    orgId: 1
    folder: ''
    type: file
    disableDeletion: true
    editable: true
    updateIntervalSeconds: 30
    allowUiUpdates: false
    options:
      path: /etc/grafana/dashboards
      # Folder = subdirectory name, so dashboards/<Folder>/foo.json lands in <Folder>.
      # Keeps each dashboard with its area (and its alerts) instead of all in General.
      foldersFromFilesStructure: true
