groups:
  - name: host_health
    rules:
      - alert: ServerDown
        expr: up{job="node"} == 0
        for: 2m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "Server is down"
{% raw %}
          description: "Prometheus cannot reach {{ $labels.instance }}."
{% endraw %}

      - alert: DiskUsageCritical
        expr: (1 - (node_filesystem_avail_bytes{fstype!="tmpfs",mountpoint=~"/|/srv.*"} / node_filesystem_size_bytes{fstype!="tmpfs",mountpoint=~"/|/srv.*"})) * 100 > 90
        for: 10m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "Disk usage above 90%"
{% raw %}
          description: "{{ $labels.mountpoint }} at {{ $value | humanize }}% on {{ $labels.instance }}."
{% endraw %}

      - alert: DiskWillFillSoon
        expr: predict_linear(node_filesystem_avail_bytes{fstype!="tmpfs",mountpoint=~"/|/srv.*"}[6h], 24 * 3600) < 0
        for: 30m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "Disk likely to fill within 24 hours"
{% raw %}
          description: "{{ $labels.mountpoint }} on {{ $labels.instance }} is trending to full within 24 hours."
{% endraw %}

      - alert: MemoryExhaustionCritical
        expr: (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100 < 5
        for: 10m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "Memory almost exhausted"
{% raw %}
          description: "Available memory below 5% on {{ $labels.instance }}."
{% endraw %}

      - alert: HostSaturationCritical
        expr: |
          (
            node_load15 / on(instance, env) count by (instance, env) (node_cpu_seconds_total{mode="idle"}) > 1.5
          )
          and on(instance, env)
          (
            100 - (avg by (instance, env) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 90
          )
        for: 15m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "Host is saturated"
{% raw %}
          description: "CPU usage above 90% and 15-minute load above 1.5x CPU cores on {{ $labels.instance }}."
{% endraw %}

      - alert: PublicEndpointDown
        expr: probe_success{job=~"blackbox_.*"} == 0
        for: 10m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "Public endpoint is down"
{% raw %}
          description: "{{ $labels.service }} endpoint {{ $labels.instance }} is failing from internal monitoring."
{% endraw %}

      - alert: TlsCertificateRenewalFailing
        expr: (probe_ssl_earliest_cert_expiry{job=~"blackbox_.*"} - time()) < 7 * 24 * 3600
        for: 1h
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "TLS certificate auto-renewal is failing"
{% raw %}
          description: "{{ $labels.instance }} TLS certificate expires in less than 7 days. Traefik should renew automatically, so DNS, HTTP-01 reachability, Traefik, and ACME storage need investigation."
{% endraw %}

      # The host resolver is what every container's lookups end up at. When it is
      # stuck (2026-09-20: resolved parked on the unreachable IPv6 upstream) logins,
      # Google sign-in, log shipping and tile fetches all fail while /health stays green.
      - alert: HostDnsResolutionFailing
        expr: hero2_dns_lookup_success == 0
        for: 3m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "Host DNS resolution is failing"
{% raw %}
          description: "{{ $labels.instance }} cannot resolve {{ $labels.name }} through its resolver, so every container on it fails the same lookup. Check `resolvectl status` on the host; the docker role pins IPv4 upstreams and `resolvectl dns <iface> <servers>` restores service immediately."
{% endraw %}

      # A container in a restart loop passes shallow probes (the labeling API restarted
      # 29,000 times behind a green frontend probe). cadvisor opens a fresh series per
      # (re)start, so counting distinct series per container name over 30m counts starts.
      - alert: ContainerRestartLoop
        expr: count by (name, env, instance) (last_over_time(container_start_time_seconds{name!=""}[30m])) > 3
        for: 10m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "Container is restart-looping"
{% raw %}
          description: "{{ $labels.name }} ({{ $labels.env }}) started {{ $value }} times in the last 30 minutes. Read `docker logs` for the startup crash; the service is not serving."
{% endraw %}

  # Catches the failure mode the PR #88 follow-up flagged: the backend's
  # startTripResultsWorker has died but the HTTP /health check still returns 200.
  # The blackbox probe can't see it; only the queue can.
  - name: bullmq_queues
    rules:
      # Failed sets are terminal: those trips never reach the user and are invisible in
      # the DB (the 2026-06 incident sat at 1845 failed sensor jobs behind green
      # dashboards). Any non-empty failed set pages.
      - alert: BullQueueFailedJobs
        expr: redis_key_size{job="redis_bullmq",key=~"bull:.*:failed"} > 0
        for: 15m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "BullMQ jobs are failing terminally"
{% raw %}
          description: "{{ $labels.env }}: {{ $labels.key }} holds {{ $value }} failed job(s). These trips will never reach a user; inspect failedReason on the queue and replay or drain."
{% endraw %}

      - alert: TripResultsQueueBacklog
        expr: redis_key_size{job="redis_bullmq",key="bull:trip_results:wait"} > 100
        for: 10m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "Backend not consuming trip-inference results"
{% raw %}
          description: "{{ $labels.env }}: bull:trip_results:wait has {{ $value }} pending jobs. The trip-inference microservice is producing results but the backend's startTripResultsWorker is not consuming them. Check backend logs and Redis worker liveness."
{% endraw %}

      - alert: SensorProcessingQueueBacklog
        expr: redis_key_size{job="redis_bullmq",key="bull:sensor_processing_jobs:wait"} > 100
        for: 10m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "Trip-inference microservice not consuming sensor batches"
{% raw %}
          description: "{{ $labels.env }}: bull:sensor_processing_jobs:wait has {{ $value }} pending jobs. The backend is enqueueing sensor batches but the trip-inference microservice is not picking them up. Check the trip-inference deployment."
{% endraw %}

      - alert: SensorCompactionQueueBacklog
        expr: redis_key_size{job="redis_bullmq",key="bull:sensor_compaction:wait"} > 5
        for: 1h
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "Daily sensor compaction job not running"
{% raw %}
          description: "{{ $labels.env }}: bull:sensor_compaction:wait has {{ $value }} pending jobs older than an hour. The scheduled compaction worker (cron 0 10 * * * UTC) is queueing jobs but the worker is not draining them. Check backend startup logs."
{% endraw %}

  # Nightly backups (roles backup-client and backup-server). The app VMs report
  # when every part of a backup last succeeded; the internal VM reports its
  # prune, data check and restore test. Backup metrics carry backup_env, since
  # the scrape target's own env label is the reporting VM's.
  - name: backups
    rules:
      - alert: BackupMissing
        expr: time() - hero2_backup_last_success_timestamp_seconds > 26 * 3600
        for: 30m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "No successful backup in over a day"
{% raw %}
          description: "{{ $labels.backup_env }} has gone {{ $value | humanizeDuration }} without a complete backup. Check `journalctl -u hero2-backup` on the app VM."
{% endraw %}

      - alert: BackupNeverReported
        expr: absent(hero2_backup_last_success_timestamp_seconds{backup_env="staging"}) or absent(hero2_backup_last_success_timestamp_seconds{backup_env="production"})
        for: 26h
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "An environment has never reported a backup"
{% raw %}
          description: "{{ $labels.backup_env }} has no backup metric at all. Check that hero2-backup.timer is enabled on its VM and that node-exporter reads /var/lib/node-exporter."
{% endraw %}

      - alert: BackupFailed
        expr: hero2_backup_last_run_success == 0
        for: 5m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "Last night's backup failed"
{% raw %}
          description: "The latest backup run on {{ $labels.backup_env }} failed; the previous snapshot is still the newest. Check `journalctl -u hero2-backup` on the app VM."
{% endraw %}

      - alert: BackupUnusable
        expr: hero2_backup_restore_test_success == 0 or hero2_backup_check_success == 0 or time() - hero2_backup_restore_test_timestamp_seconds > 8 * 86400 or time() - hero2_backup_check_timestamp_seconds > 8 * 86400
        for: 5m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "A backup failed its restore test or data check"
{% raw %}
          description: "The {{ $labels.backup_env }} backups could not be restored, failed `restic check`, or have not been tested for over a week. Check `journalctl -u hero2-backup-maintain` on the internal VM."
{% endraw %}

      - alert: BackupUpkeepFailing
        expr: hero2_backup_prune_success == 0 unless hero2_backup_suspect_snapshots > 0 or time() - hero2_backup_prune_timestamp_seconds > 2 * 86400
        for: 5m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "Backup upkeep is failing or has stopped"
{% raw %}
          description: "The upkeep of the {{ $labels.backup_env }} backups failed or has not run on time, so old snapshots are not pruned or checked. Check `journalctl -u hero2-backup-maintain` on the internal VM."
{% endraw %}

      - alert: BackupTampered
        expr: hero2_backup_suspect_snapshots > 0
        for: 5m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "Backups hold snapshots with a false time"
{% raw %}
          description: "{{ $labels.backup_env }} has {{ $value }} snapshot(s) whose time differs from when the server received them, so pruning is stopped. An app VM may be compromised. Check `journalctl -u hero2-backup-maintain` on the internal VM before removing anything."
{% endraw %}

  # Live transit positions (role transit-recorder). 511 keeps no archive, so a
  # gap in the recording can never be back-filled.
  - name: transit
    rules:
      - alert: TransitRecorderStale
        expr: time() - hero2_transit_rt_last_success_timestamp_seconds > 1800 or absent(hero2_transit_rt_last_success_timestamp_seconds)
        for: 15m
        labels:
          severity: critical
          notify_resolved: "true"
        annotations:
          summary: "Live transit positions are not being recorded"
          description: "No 511 vehicle-position snapshot in 30 minutes; these cannot be back-filled. Check `systemctl status hero2-transit-record` on the internal VM."
