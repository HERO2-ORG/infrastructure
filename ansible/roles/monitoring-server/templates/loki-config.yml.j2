auth_enabled: false

server:
  http_listen_port: 3100
  grpc_listen_port: 9096

common:
  instance_addr: 127.0.0.1
  path_prefix: /loki
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: "2024-01-01"
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

limits_config:
  retention_period: 30d
  # Cap label cardinality — analyticsId/sessionId must NOT be labels, only parsed fields
  max_label_names_per_series: 15
  allow_structured_metadata: false
  # Backstop: labels are bounded (level/source/env), but cap total streams so an
  # unexpected high-cardinality label can never exhaust Loki's index/memory.
  max_streams_per_user: 10000

compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  # Required by Loki 3.x whenever retention is enabled, else the compactor (and the
  # single-binary process) refuses to start.
  delete_request_store: filesystem

query_range:
  results_cache:
    cache:
      embedded_cache:
        enabled: true
        max_size_mb: 100
