#jinja2: trim_blocks: False
# trim_blocks (Ansible's default) drops the newline after a block tag. The Go templates
# below must be wrapped in {% raw %}, and each `text:` block scalar ends on a line whose
# last token is {% endraw %}, so the trimmed newline folded the next receiver's
# `- name:` into the scalar and turned its `slack_configs:` into a duplicate key on the
# previous receiver. Alertmanager then refused to load its config and crash-looped,
# silently delivering nothing. Keep this header; `amtool check-config` in the role's
# tasks is the backstop that fails the deploy instead of shipping a dead alertmanager.
route:
  group_by:
    - env
    - alertname
    - instance
  group_wait: 30s
  group_interval: 10m
  repeat_interval: 12h
  receiver: drop
  routes:
    # State alerts (queue depth, disk, host health) opt in via notify_resolved: the
    # condition measurably ending is real information. Log-count alerts must NOT set
    # it - their "resolved" only means "quiet for one evaluation window", not fixed.
    - receiver: slack-alerts-resolving
      matchers:
        - severity="critical"
        - notify_resolved="true"
    - receiver: slack-alerts
      matchers:
        - severity="critical"

receivers:
  - name: drop
  - name: slack-alerts-resolving
    slack_configs:
      - api_url: "{{ monitoring_slack_webhook_url }}"
        channel: "{{ monitoring_slack_channel }}"
        username: Hero2 Monitoring
        send_resolved: true
        icon_emoji: '{% raw %}{{ if eq .Status "firing" }}:rotating_light:{{ else }}:white_check_mark:{{ end }}{% endraw %}'
        color: '{% raw %}{{ if eq .Status "firing" }}danger{{ else }}good{{ end }}{% endraw %}'
        title: '{% raw %}[{{ .Status | toUpper }}{{ if eq .Status "firing" }}:{{ .Alerts.Firing | len }}{{ end }}] {{ .CommonLabels.alertname }}{{ with .CommonLabels.env }} · {{ . }}{{ end }}{% endraw %}'
        text: |-
          {% raw %}{{ range .Alerts -}}
          *{{ .Annotations.summary }}*
          {{ .Annotations.description }}
          {{- with .Labels.service }}
          service: `{{ . }}` · {{ end }}severity: `{{ .Labels.severity }}`

          {{ end -}}{% endraw %}
  - name: slack-alerts
    slack_configs:
      - api_url: "{{ monitoring_slack_webhook_url }}"
        channel: "{{ monitoring_slack_channel }}"
        username: Hero2 Monitoring
        send_resolved: false
        icon_emoji: '{% raw %}{{ if eq .Status "firing" }}:rotating_light:{{ else }}:white_check_mark:{{ end }}{% endraw %}'
        color: '{% raw %}{{ if eq .Status "firing" }}danger{{ else }}good{{ end }}{% endraw %}'
        title: '{% raw %}[{{ .Status | toUpper }}{{ if eq .Status "firing" }}:{{ .Alerts.Firing | len }}{{ end }}] {{ .CommonLabels.alertname }}{{ with .CommonLabels.env }} · {{ . }}{{ end }}{% endraw %}'
        text: |-
          {% raw %}{{ range .Alerts -}}
          *{{ .Annotations.summary }}*
          {{ .Annotations.description }}
          {{- with .Labels.service }}
          service: `{{ . }}` · {{ end }}severity: `{{ .Labels.severity }}`

          {{ end -}}{% endraw %}
