discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "1s"

  filter {
    name   = "status"
    values = ["running"]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    replacement  = "{{ app_environment }}"
    target_label = "env"
  }
}

loki.source.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.containers.output
  forward_to       = [loki.process.pipeline.receiver]
  refresh_interval = "1s"
}

// Changes to this file only take effect through the role's config-change restart:
// the file is bind-mounted, so compose alone never recreates the alloy container.
loki.process "pipeline" {
  forward_to = [loki.write.loki.receiver]

  // loki.source.docker reads via the Docker API and delivers the line already
  // unwrapped (NO {"log":...,"time":...} envelope - that wrapper only exists in the
  // json-file driver's files). An earlier envelope-parsing stage here meant the inner
  // parse never ran and level/source were never promoted, which silently disabled the
  // alerts' source!="flutter" scoping: an absent label matches the negative matcher,
  // so client-submitted /logs errors could page.
  //
  // Only level/source become labels (bounded cardinality). errorType is
  // attacker-controllable free text, so it stays a query-time `| json` field (the
  // dashboards/alerts parse it) and is never a Loki stream label. analyticsId/
  // sessionId likewise stay as parsed fields only — never labels.
  stage.json {
    expressions = {
      level  = "level",
      source = "source",
    }
  }

  stage.labels {
    values = {
      level  = "",
      source = "",
    }
  }
}

loki.write "loki" {
  endpoint {
    url = "https://{{ loki_domain }}/loki/api/v1/push"

    basic_auth {
      username = "{{ loki_basic_auth_user }}"
      password = "{{ loki_basic_auth_password }}"
    }
  }
}
