# Append-only restic repositories for the app VMs, one private repository per
# environment. Clients can add snapshots but never delete them; pruning runs on
# this host against the files (hero2-backup-maintain).
x-logging: &default-logging
  driver: json-file
  options:
    max-size: "50m"
    max-file: "3"

services:
  rest-server:
    image: restic/rest-server:0.14.0@sha256:d2aff06f47eb38637dff580c3e6bce4af98f386c396a25d32eb6727ec96214a5
    logging: *default-logging
    command:
      - rest-server
      - --path=/data
      - --listen=:{{ backup_rest_port }}
      - --append-only
      - --private-repos
      - --tls
      - --tls-cert=/tls/rest-server.crt
      - --tls-key=/tls/rest-server.key
      - --htpasswd-file=/tls/.htpasswd
      # Append-only cannot be pruned by clients, so cap what they can add on a
      # disk the monitoring stack shares.
      - --max-size={{ backup_max_bytes }}
    volumes:
      - {{ backup_repo_path }}:/data
      - {{ backup_server_stack_path }}/tls:/tls:ro
    ports:
      - "{{ backup_rest_port }}:{{ backup_rest_port }}"
    restart: unless-stopped
