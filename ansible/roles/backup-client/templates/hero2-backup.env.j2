RESTIC_REPOSITORY=rest:https://{{ app_environment }}:{{ lookup('vars', 'RESTIC_REST_PASSWORD_' ~ app_environment | upper) }}@{{ groups.internal[0] }}:{{ backup_rest_port }}/{{ app_environment }}/
RESTIC_PASSWORD={{ lookup('vars', 'RESTIC_PASSWORD_' ~ app_environment | upper) }}
RESTIC_CACERT=/etc/hero2-backup/rest-server.crt
RESTIC_CACHE_DIR=/var/cache/restic
BACKUP_ENV={{ app_environment }}
